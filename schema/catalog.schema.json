{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/limad/ai-models-catalog/main/schema/catalog.schema.json",
    "title": "Catalogue de modèles IA (plugins Jeedom)",
    "type": "object",
    "required": ["schema", "generated_at", "source", "providers"],
    "additionalProperties": false,
    "properties": {
        "schema": { "const": 1 },
        "generated_at": { "type": "string", "format": "date-time" },
        "source": {
            "type": "object",
            "required": ["name", "url", "license"],
            "properties": {
                "name": { "type": "string" },
                "url": { "type": "string" },
                "license": { "type": "string" }
            }
        },
        "providers": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": { "pattern": "^[a-z0-9_]{1,32}$" },
            "additionalProperties": { "$ref": "#/$defs/provider" }
        }
    },
    "$defs": {
        "modelId": { "type": "string", "pattern": "^[A-Za-z0-9._:/-]{1,128}$" },
        "provider": {
            "type": "object",
            "required": ["label", "source_id", "models"],
            "additionalProperties": false,
            "properties": {
                "label": { "type": "string", "minLength": 1 },
                "source_id": { "type": "string" },
                "default_model": { "$ref": "#/$defs/modelId" },
                "free_tier": { "type": "boolean" },
                "models": {
                    "type": "object",
                    "minProperties": 1,
                    "propertyNames": { "$ref": "#/$defs/modelId" },
                    "additionalProperties": { "$ref": "#/$defs/model" }
                }
            }
        },
        "model": {
            "type": "object",
            "required": ["name", "status", "context", "input", "tools", "reasoning"],
            "additionalProperties": false,
            "properties": {
                "name": { "type": "string", "minLength": 1 },
                "label": { "type": "string" },
                "family": { "type": "string" },
                "release_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$" },
                "status": { "enum": ["active", "beta", "deprecated"] },
                "context": { "type": "integer", "minimum": 0 },
                "output": { "type": "integer", "minimum": 0 },
                "input": {
                    "type": "array",
                    "items": { "enum": ["text", "image", "pdf", "audio", "video"] }
                },
                "tools": { "type": "boolean" },
                "reasoning": { "type": "boolean" },
                "structured_output": { "type": "boolean" },
                "cost": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "in": { "type": "number", "minimum": 0 },
                        "out": { "type": "number", "minimum": 0 },
                        "cache_read": { "type": "number", "minimum": 0 },
                        "cache_write": { "type": "number", "minimum": 0 }
                    }
                },
                "free": { "type": "boolean" },
                "recommended": { "type": "boolean" },
                "origin": { "enum": ["models.dev", "override"] }
            }
        }
    }
}
